# Copia este archivo a `.env.produccion` (ignorado por git) y completa los
# valores. `npm run vars` comprueba sin imprimir nada; `npm run vars:subir`
# los carga en Cloudflare como secretos del Worker.

# Base de datos: rol bws_app de la rama principal de bws-contratos.
# Una cadena igual a la de pruebas se rechaza.
DATABASE_URL_APP=

# Correo: resend (recomendado) o smtp. El modo archivo no vale en producción.
CORREO_MODO=resend
# Remitente verificado en el proveedor, por ejemplo:
#   Blink Web Services <contratos@blink.com.ve>
CORREO_DESDE=
# Copia interna de cada envío. Opcional; por defecto business@blink.com.ve.
CORREO_COPIA=business@blink.com.ve

# Solo para CORREO_MODO=resend.
CORREO_API_KEY=

# Solo para CORREO_MODO=smtp. Descomenta las cinco.
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_SEGURO=no
#SMTP_USER=
#SMTP_PASS=

# Identidad fiscal que se imprime en el expediente. Sin ella, el alta
# responde 503 en producción.
BWS_RAZON_SOCIAL=Blink Web Services, C.A.
BWS_RIF=
BWS_DOMICILIO=Caracas, Distrito Capital, Venezuela
BWS_CORREO=business@blink.com.ve
BWS_TELEFONO=+1 (631) 821 1938

# Opcionales: solo si cambian las condiciones publicadas.
#TARIFA_DESARROLLO=USD 31
#TARIFA_INFRA_PRO=USD 30
#CORREO_PROVEEDOR_NOMBRE=
