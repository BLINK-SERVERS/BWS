{
  "name": "blink-bws-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Portal de contratación, firma electrónica no certificada y expedientes de Blink Web Services.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "pdf": "tsx scripts/pdf-local.mjs",
    "pdf:verificar": "tsx scripts/pdf-local.mjs --verificar",
    "afirmaciones": "tsx scripts/revisar-afirmaciones.mjs",
    "pruebas": "tsx --test pruebas/*.test.ts",
    "db:migrar": "tsx scripts/db-migrar.mjs",
    "db:pruebas": "tsx scripts/db-test.mjs",
    "api:pruebas": "tsx scripts/api-test.mjs",
    "portal": "tsx scripts/servidor.mjs",
    "portal:pruebas": "npm run build && tsx scripts/portal.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "pg": "^8.23.1",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  }
}
