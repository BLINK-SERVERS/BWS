{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bws-portal",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "vars": {
    "ENTORNO": "produccion",
    "APP_ORIGEN": "https://bws.blink.com.ve"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/portal/*",
      "/registro",
      "/registro/*",
      "/ingreso",
      "/ingreso/*",
      "/panel",
      "/panel/*",
      "/proyecto",
      "/proyecto/*",
      "/admin",
      "/admin/*",
      "/verificar",
      "/verificar/*",
      "/recuperar",
      "/recuperar/*"
    ]
  },
  "routes": [
    { "pattern": "bws.blink.com.ve/api", "zone_name": "blink.com.ve" },
    { "pattern": "bws.blink.com.ve/api/*", "zone_name": "blink.com.ve" },
    { "pattern": "bws.blink.com.ve/portal/*", "zone_name": "blink.com.ve" },
    { "pattern": "bws.blink.com.ve/registro", "zone_name": "blink.com.ve" },
    { "pattern": "bws.blink.com.ve/registro/*", "zone_name": "blink.com.ve" },
    { "pattern": "bws.blink.com.ve/ingreso", "zone_name": "blink.com.ve" },
    { "pattern": "bws.blink.com.ve/ingreso/*", "zone_name": "blink.com.ve" },
    { "pattern": "bws.blink.com.ve/panel", "zone_name": "blink.com.ve" },
    { "pattern": "bws.blink.com.ve/panel/*", "zone_name": "blink.com.ve" },
    { "pattern": "bws.blink.com.ve/proyecto", "zone_name": "blink.com.ve" },
    { "pattern": "bws.blink.com.ve/proyecto/*", "zone_name": "blink.com.ve" },
    { "pattern": "bws.blink.com.ve/admin", "zone_name": "blink.com.ve" },
    { "pattern": "bws.blink.com.ve/admin/*", "zone_name": "blink.com.ve" },
    { "pattern": "bws.blink.com.ve/verificar", "zone_name": "blink.com.ve" },
    { "pattern": "bws.blink.com.ve/verificar/*", "zone_name": "blink.com.ve" },
    { "pattern": "bws.blink.com.ve/recuperar", "zone_name": "blink.com.ve" },
    { "pattern": "bws.blink.com.ve/recuperar/*", "zone_name": "blink.com.ve" }
  ],
  "rules": [{ "type": "Data", "globs": ["**/*.ttf"], "fallthrough": false }],
  "durable_objects": {
    "bindings": [{ "name": "CARGA", "class_name": "Carga" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Carga"] }],
  "observability": { "enabled": true }
}
