{
  "name": "ruta-marketplace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Car Market, marketplace independiente de carros. Prototipo Powered by Blink.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "dev:worker": "node scripts/dev-worker.mjs",
    "worker:types": "wrangler types",
    "db:migrate": "node scripts/db-migrar.mjs",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:auth": "node tests/auth-api.mjs",
    "test:browser": "node tests/navegador.mjs"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "wrangler": "^4.168.0"
  }
}
